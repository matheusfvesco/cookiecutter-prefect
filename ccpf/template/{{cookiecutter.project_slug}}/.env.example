# Deployment defaults. Copy this file to .env before using Compose.
PREFECT_API_URL={{ cookiecutter.prefect_server_url }}
# Change this when Prefect is not a container on the generated Docker network.
PREFECT_CONTAINER_API_URL=http://prefect-server:{{ cookiecutter.prefect_server_port }}/api
PREFECT_SERVER_PORT={{ cookiecutter.prefect_server_port }}
PREFECT_WORK_POOL={{ cookiecutter.work_pool_name }}
PREFECT_IMAGE={{ cookiecutter.image_name }}:{{ cookiecutter.image_tag }}

# Add environment variables required by this project here.
